{
  "name": "BODAQS A8 ESP32-S3 Mini N4R2",
  "vendor": "BODAQS",
  "url": "https://github.com/",
  "platform": "espressif32",
  "frameworks": [
    "arduino"
  ],
  "connectivity": [
    "wifi",
    "bluetooth"
  ],
  "hardware": {
    "flash": 4194304,
    "ram": 327680
  },
  "build": {
    "arduino": {
      "ldscript": "esp32s3_out.ld"
    },
    "core": "esp32",
    "mcu": "esp32s3",
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "variant": "bodaqs_s3_mini_n4r2",
    "extra_flags": [
      "-DBODAQS_ESP32S3_MINI_N4R2",
      "-DARDUINO_USB_MODE=1",
      "-DARDUINO_RUNNING_CORE=1",
      "-DARDUINO_EVENT_RUNNING_CORE=1",
      "-DBOARD_HAS_PSRAM"
    ]
  },
  "debug": {
    "default_tool": "esp-builtin",
    "onboard_tools": [
      "esp-builtin"
    ],
    "openocd_target": "esp32s3.cfg"
  },
  "upload": {
    "flash_size": "4MB",
    "maximum_size": 4194304,
    "maximum_ram_size": 327680,
    "require_upload_port": true,
    "speed": 460800
  }
}
